<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include shared preferences (user settings, game progress) -->
    <include domain="sharedpref" path="." />

    <!-- Include database -->
    <include domain="database" path="." />

    <!-- Include internal file storage for saved game data -->
    <include domain="file" path="player_data/" />
    <include domain="file" path="themes/" />

    <!-- Exclude device-specific identifiers and tokens -->
    <exclude domain="sharedpref" path="device_id.xml" />
    <exclude domain="sharedpref" path="firebase_token.xml" />
    <exclude domain="sharedpref" path="fcm_token.xml" />
    <exclude domain="sharedpref" path="installation_id.xml" />

    <!-- Exclude temporary and cached data -->
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="tmp/" />
    <exclude domain="file" path="logs/" />
    <exclude domain="external" path="." />

    <!-- Exclude auth session data (re-auth on restore) -->
    <exclude domain="sharedpref" path="auth_session.xml" />
    <exclude domain="sharedpref" path="google_sign_in_token.xml" />
</full-backup-content>